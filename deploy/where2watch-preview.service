[Unit]
Description=where2watch Flutter web preview
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/srv/projects/where2watch-preview
ExecStart=/usr/bin/python3 /srv/projects/where2watch-preview/server/server.py
Environment=PORT=8096
EnvironmentFile=-/etc/where2watch-preview.env
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
